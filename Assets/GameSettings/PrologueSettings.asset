  m_Script: {fileID: 11500000, guid: 24b2c333e0f412648b025078db6a7ff6, type: 3}
  m_Name: PrologueSettings
  m_EditorClassIdentifier: Assembly-CSharp::PrologueSettings
  text: "Buenos Aires, junio de 1956.\n\nSos periodista. Hace a\xF1os que escrib\xEDs
    sobre robos, choques y cr\xEDmenes de barrio, en las p\xE1ginas que nadie lee.\n\nEsta
    ma\xF1ana, todos los diarios repiten la misma noticia: dos subversivos abatidos
    en un tiroteo con la polic\xEDa. Caso cerrado.\n\nPero anoche alguien te dej\xF3
    un sobre sin remitente. Adentro hab\xEDa una foto de la cocina donde todo empez\xF3,
    y una sola frase: \u201CNo fue as\xED.\u201D\n\nRevis\xE1 la escena. Un\xED las
    pistas en tu tablero: cada verdad se sostiene sobre tres pruebas. Llam\xE1 a
    tu fuente para confirmarlas.\n\nY antes de que alguien venga a buscarte, escrib\xED
    lo que realmente pas\xF3."
  voice: {fileID: 0}
  textDelay: 1
  holdDuration: 3
  textFadeDuration: 1.5
  blackHoldDuration: 1
