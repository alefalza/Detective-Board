  - evidenceA: {fileID: 11400000, guid: 8c355582d76d89f46b834fe26e18e963, type: 2}
    evidenceB: {fileID: 11400000, guid: 64c924aa725dc1443bfbc187adbd84d9, type: 2}
    text: "Detenidos a las 23:30 y un auto sin identificar en la puerta. \xBFDe qui\xE9n
      era?"
  - evidenceA: {fileID: 11400000, guid: 72b29faf1a851044e9a9142376e23d40, type: 2}
    evidenceB: {fileID: 11400000, guid: 64c924aa725dc1443bfbc187adbd84d9, type: 2}
    text: "La patente del auto est\xE1 en la planilla policial. \xBFA qu\xE9 hora
      actuaron?"
  resultDescription: "Los detuvo <keyword>la polic\xEDa</keyword> a las 23:30, <keyword>antes
    de la ley marcial</keyword>, y el auto sospechoso era de la propia fuerza."
