  m_Script: {fileID: 11500000, guid: 7d6073edae784d749af14a2479148e6e, type: 3}
  m_Name: SensacionalistaTone
  m_EditorClassIdentifier: Assembly-CSharp::ToneData
  displayName: Sensacionalista
  epilogueText: "Esa ma\xF1ana se agot\xF3 la edici\xF3n. Los canillitas gritaban
    el titular en cada esquina, y por unos d\xEDas todo Buenos Aires habl\xF3 de
    la masacre de Jos\xE9 Le\xF3n Su\xE1rez.\n\nDespu\xE9s lleg\xF3 otro esc\xE1ndalo,
    y otro m\xE1s.\n\nLa esposa no volvi\xF3 a atender el tel\xE9fono. Su nombre
    hab\xEDa quedado impreso junto a las fotos, al lado de cosas que nunca dijo.\n\nHab\xEDas
    dicho la verdad, pero de una forma en que ya nadie pod\xEDa creerla. El ruido
    se la llev\xF3, como se lleva todo."
  epilogueVoice: {fileID: 0}
